# Hostinger (LiteSpeed / Apache) config for the SPA frontend.
# Rewrites every non-file request to /index.html so React Router owns routing.

RewriteEngine On

# Force HTTPS (Hostinger provides a free Let's Encrypt cert)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA fallback — anything that isn't an existing file or directory → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Long-cache immutable Vite assets (they have content hashes in filenames)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache the entry HTML — new deploys must be picked up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Small security hardening
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip/Brotli — LiteSpeed does this automatically, no-op on Apache without deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
