# Production API base URL baked into the mobile app build.
#
# A packaged mobile app has NO dev proxy and cannot reach "localhost" (on a
# phone, localhost is the phone itself). Point this at your deployed backend,
# e.g. https://api.yoursalon.com/api/v1
#
# Quick options for testing before you deploy:
#   • Android emulator  -> http://10.0.2.2:5000/api/v1   (10.0.2.2 = host PC)
#   • Real device (LAN) -> http://<your-PC-LAN-IP>:5000/api/v1
#
# Replace the value below with your real backend URL before a store build.
VITE_API_URL=https://REPLACE-WITH-YOUR-BACKEND/api/v1
VITE_APP_NAME=Studieo
