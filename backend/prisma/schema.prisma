// Salon Management System - Database Schema
// Prisma + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PROMOTION
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum HolidayBehavior {
  BLOCK
  REDUCED
  WARN
}

enum PaymentMethodType {
  CASH
  DIGITAL
  CARD
  BANK_TRANSFER
}

enum PaymentGateway {
  NONE
  RAZORPAY
  STRIPE
  PAYU
  PAYPAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  profile          UserProfile?
  staff            Staff?
  customer         Customer?
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  productSales     ProductSale[] @relation("CustomerProductSales")
  memberships      Membership[]  @relation("CustomerMemberships")

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  dob       DateTime?
  gender    Gender?
  address   String?
  city      String?
  state     String?
  country   String?
  postcode  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// LOCATION
// ============================================

model Country {
  id     String  @id @default(uuid())
  name   String  @unique
  code   String  @unique
  states State[]

  @@map("countries")
}

model State {
  id        String @id @default(uuid())
  countryId String
  name      String
  cities    City[]
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id       String   @id @default(uuid())
  stateId  String
  name     String
  branches Branch[]
  state    State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, name])
  @@map("cities")
}

// ============================================
// BRANCH
// ============================================

model Branch {
  id          String   @id @default(uuid())
  name        String
  description String?
  address     String
  cityId      String
  phone       String
  email       String
  logo        String?
  latitude    Float?
  longitude   Float?
  openTime    String   @default("09:00")
  closeTime   String   @default("21:00")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  city     City             @relation(fields: [cityId], references: [id])
  services BranchService[]
  staff    Staff[]
  bookings Booking[]
  products Product[]
  productSales ProductSale[]

  @@map("branches")
}

// ============================================
// SERVICES
// ============================================

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  parentId    String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent   ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ServiceCategory[] @relation("CategoryHierarchy")
  services Service[]

  @@map("service_categories")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  memberPrice Decimal? @db.Decimal(10, 2)  // Optional member price. Null = same as regular.
  duration    Int      // in minutes
  categoryId  String
  image       String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  ServiceCategory  @relation(fields: [categoryId], references: [id])
  branches  BranchService[]
  staff     StaffService[]
  bookings  Booking[]

  @@index([categoryId])
  @@map("services")
}

model BranchService {
  branchId  String
  serviceId String
  price     Decimal? @db.Decimal(10, 2)  // Optional branch-specific pricing

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([branchId, serviceId])
  @@map("branch_services")
}

// ============================================
// STAFF
// ============================================

model Staff {
  id             String   @id @default(uuid())
  userId         String   @unique
  branchId       String
  employeeCode   String   @unique
  designation    String?
  joiningDate    DateTime @default(now())
  salary         Decimal? @db.Decimal(10, 2)
  commissionRate Decimal? @db.Decimal(5, 2)  // Percentage
  monthlyTarget  Decimal? @db.Decimal(10, 2) // Revenue target; commission is paid only on the portion above target. Null or 0 = no target (flat commission).
  isVerified     Boolean  @default(false)
  bio            String?
  experience     Int?     // in years
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id])
  services   StaffService[]
  schedules  StaffSchedule[]
  bookings   Booking[]
  earnings   StaffEarning[]
  payouts    Payout[]
  productSales ProductSale[]

  @@index([branchId])
  @@map("staff")
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model StaffSchedule {
  id        String  @id @default(uuid())
  staffId   String
  dayOfWeek Int     // 0-6 (Sunday-Saturday)
  startTime String  // "09:00"
  endTime   String  // "18:00"
  isOff     Boolean @default(false)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id             String   @id @default(uuid())
  userId         String   @unique
  loyaltyPoints  Int      @default(0)
  totalVisits    Int      @default(0)
  totalSpent     Decimal  @default(0) @db.Decimal(10, 2)
  preferences    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customers")
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  customerId    String
  staffId       String
  branchId      String
  serviceId     String
  bookingDate   DateTime
  startTime     String        // "14:30"
  endTime       String        // "15:30"
  status        BookingStatus @default(PENDING)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentRef    String?
  paidAt        DateTime?
  couponId      String?
  notes         String?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer User    @relation("CustomerBookings", fields: [customerId], references: [id])
  staff    Staff   @relation(fields: [staffId], references: [id])
  branch   Branch  @relation(fields: [branchId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  review   Review?
  earning  StaffEarning?
  productSale ProductSale?

  @@index([customerId])
  @@index([staffId])
  @@index([branchId])
  @@index([bookingDate])
  @@map("bookings")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType    @default(GENERAL)
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  data      Json?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  name      String              @unique
  type      NotificationType
  channel   NotificationChannel
  subject   String?
  body      String
  variables Json?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("notification_templates")
}

// ============================================
// FINANCE
// ============================================

model Tax {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("taxes")
}

model StaffEarning {
  id               String       @id @default(uuid())
  staffId          String
  bookingId        String?      @unique
  productSaleId    String?      @unique
  baseAmount       Decimal      @db.Decimal(10, 2)
  commissionRate   Decimal      @db.Decimal(5, 2)
  commissionAmount Decimal      @db.Decimal(10, 2)
  payoutStatus     PayoutStatus @default(PENDING)
  payoutId         String?
  createdAt        DateTime     @default(now())

  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productSale  ProductSale? @relation(fields: [productSaleId], references: [id], onDelete: Cascade)
  payout       Payout?      @relation(fields: [payoutId], references: [id])

  @@index([staffId])
  @@index([payoutStatus])
  @@map("staff_earnings")
}

model Payout {
  id            String       @id @default(uuid())
  staffId       String
  amount        Decimal      @db.Decimal(10, 2)
  periodStart   DateTime
  periodEnd     DateTime
  status        PayoutStatus @default(PENDING)
  paymentMethod String?
  reference     String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  staff    Staff          @relation(fields: [staffId], references: [id])
  earnings StaffEarning[]

  @@index([staffId])
  @@index([status])
  @@map("payouts")
}

// ============================================
// COUPONS & PROMOTIONS
// ============================================

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int          @default(0)
  perUserLimit   Int?
  validFrom      DateTime
  validTo        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings Booking[]

  @@map("coupons")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  customerId String
  staffId    String
  serviceId  String
  rating     Int      // 1-5
  comment    String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([serviceId])
  @@map("reviews")
}

// ============================================
// SETTINGS (Phase 2 extension)
// ============================================

// Key-value settings store — one row per setting key.
// Used for Branding, Currency, and Business config.
// Type field lets us group related keys (e.g. all "BRANDING" keys)
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON-encoded value
  type      String   // "BRANDING" | "CURRENCY" | "BUSINESS" | "NOTIFICATIONS" | ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("settings")
}

model Holiday {
  id        String          @id @default(uuid())
  name      String
  date      DateTime        @db.Date
  repeats   Boolean         @default(false)
  behavior  HolidayBehavior @default(BLOCK)
  color     String          @default("#ef4444")
  branchIds String[]        @default([])  // empty = applies to all branches
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([date])
  @@map("holidays")
}

model PaymentMethod {
  id           String            @id @default(uuid())
  name         String
  type         PaymentMethodType @default(CASH)
  gateway      PaymentGateway    @default(NONE)
  icon         String            @default("💵")
  enabled      Boolean           @default(true)
  sortOrder    Int               @default(0)
  testMode     Boolean           @default(false)
  apiKey       String?           // Encrypted in production!
  apiSecret    String?           // Encrypted in production!
  webhookUrl   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("payment_methods")
}

// ============================================
// PRODUCTS & PRODUCT SALES
// ============================================

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  icon      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("product_categories")
}

model Product {
  id           String    @id @default(uuid())
  branchId     String
  categoryId   String?
  name         String
  sku          String?   @unique
  barcode      String?   @unique
  brand        String?
  description  String?
  image        String?
  mrp          Decimal   @db.Decimal(10, 2)
  buyPrice     Decimal   @db.Decimal(10, 2)
  sellPrice    Decimal   @db.Decimal(10, 2)
  memberPrice  Decimal?  @db.Decimal(10, 2)   // Member price. Null = same as sellPrice.
  stock        Int       @default(0)
  reorderLevel Int       @default(5)
  expiryDate   DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch    Branch            @relation(fields: [branchId], references: [id])
  category  ProductCategory?  @relation(fields: [categoryId], references: [id])
  saleItems ProductSaleItem[]

  @@index([branchId])
  @@index([categoryId])
  @@index([expiryDate])
  @@map("products")
}

model ProductSale {
  id             String        @id @default(uuid())
  saleNumber     String        @unique
  branchId       String
  customerId     String?
  staffId        String?
  bookingId      String?       @unique
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paymentMethod  String?
  paymentStatus  PaymentStatus @default(PAID)
  notes          String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch   Branch            @relation(fields: [branchId], references: [id])
  customer User?             @relation("CustomerProductSales", fields: [customerId], references: [id])
  staff    Staff?            @relation(fields: [staffId], references: [id])
  booking  Booking?          @relation(fields: [bookingId], references: [id])
  items    ProductSaleItem[]
  earning  StaffEarning?

  @@index([branchId])
  @@index([customerId])
  @@index([staffId])
  @@index([createdAt])
  @@map("product_sales")
}

model ProductSaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("product_sale_items")
}

// ============================================
// MEMBERSHIPS
// ============================================

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)   // Fee the customer pays to join
  durationDays Int                             // 30 / 90 / 365 …
  color        String   @default("#dc2626")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]

  @@map("membership_plans")
}

// ============================================
// ACCESS CONTROL (Role × Permission matrix)
// ============================================

model Permission {
  id         String   @id @default(uuid())
  key        String   @unique   // e.g. "bookings.delete"
  label      String              // "Delete bookings"
  category   String              // "Bookings"
  createdAt  DateTime @default(now())

  roles RolePermission[]

  @@index([category])
  @@map("permissions")
}

model Inquiry {
  id            String        @id @default(uuid())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  source        String?         // "website" / "walkin" / "phone" / etc.
  status        InquiryStatus  @default(NEW)
  internalNote  String?
  respondedById String?         // Admin user who last handled it
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model RolePermission {
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model Membership {
  id            String           @id @default(uuid())
  customerId    String                          // FK -> User
  planId        String
  startDate     DateTime
  endDate       DateTime
  paidAmount    Decimal          @db.Decimal(10, 2)
  paymentMethod String?
  status        MembershipStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer User           @relation("CustomerMemberships", fields: [customerId], references: [id])
  plan     MembershipPlan @relation(fields: [planId], references: [id])

  @@index([customerId])
  @@index([endDate])
  @@index([status])
  @@map("memberships")
}
